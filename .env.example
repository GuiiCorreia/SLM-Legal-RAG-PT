# ============================================================
# SLM-Legal-RAG-PT — environment variables
# Copy to .env and fill in your keys. NEVER commit a .env with real keys.
# ============================================================

# --- LLM provider ---
# All experiments in the paper were run through DeepInfra.
# Options: deepinfra | openrouter
LLM_PROVIDER=deepinfra

# --- DeepInfra (OpenAI-compatible) ---
# Get a key at https://deepinfra.com
# DEEPINFRA_API_KEY=...
# DEEPINFRA_TIMEOUT=120

# --- OpenRouter (optional alternative provider) ---
# Get a key at https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-...

# --- Google Gemini (second judge, used for Cohen's kappa in Table 6) ---
# Get a key at https://aistudio.google.com/app/apikey
# Model used: gemini-2.5-flash
# GEMINI_API_KEY=AIza...

# --- Dataset paths (relative to the repository root; see README) ---
BILLS_DATASET_PATH=bills_dataset.csv
FEEDBACK_DATASET_PATH=relevance_feedback_dataset.csv

# --- Dense retrieval embeddings ---
# BGE-M3 (Chen et al., 2024) — the dense retriever evaluated in the paper
EMBEDDING_MODEL=BAAI/bge-m3

# --- Retrieval parameters (Robertson & Zaragoza, 2009; Cormack et al., 2009) ---
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
EXPERIMENT_TOP_K_RETRIEVAL=50

# --- Generation / judging (paper settings) ---
LLM_ORACLE_MODEL=Qwen/Qwen2.5-72B-Instruct
DEEPINFRA_JUDGE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Output ---
RESULTS_DIR=results
LOGS_DIR=logs
LOG_LEVEL=INFO
